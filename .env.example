# ===== PostgreSQL (used by docker-compose) =====
POSTGRES_USER=techpulse
POSTGRES_PASSWORD=techpulse
POSTGRES_DB=techpulse
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_PORT=6379

# ===== Connection strings for LOCAL (non-Docker) Go tools =====
# Used by `make migrate`, `make ingest` and `go run ./cmd/api` on the host.
DATABASE_URL=postgres://techpulse:techpulse@localhost:5432/techpulse?sslmode=disable
REDIS_ADDR=localhost:6379

# ===== API =====
API_PORT=8080
# Comma-separated list of allowed browser origins (CORS). Default: the dashboard.
CORS_ORIGINS=http://localhost:3000

# ===== Ingestion =====
INGESTION_INTERVAL=30m
INGESTION_FEEDS=configs/feeds.json

# ===== Web (Next.js) — server-side, not exposed to the browser =====
API_URL=http://localhost:8080
WEB_PORT=3000
